# ─────────────────────────────────────────────────────────────────────────────
# CodeSense AI — Backend environment variables
#
# Copy this file to .env and fill in every value marked <required>.
# .env is gitignored and must never be committed.
#
# Quick start:
#   cp .env.example .env
#   # edit .env, then:
#   set -a && source .env && set +a   # bash/zsh
#   # or on Windows PowerShell:
#   Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Default postgres password for local dev. Change for any shared/cloud env.
DB_PASSWORD=postgres

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Register / manage your OAuth App at https://github.com/settings/developers
# Callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=Ov23lio4qDBYKi2LYvZC
GITHUB_CLIENT_SECRET=<required — generate a new secret after rotating the exposed one>

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong random value: openssl rand -base64 32
# Minimum 32 characters. Must be the same across all backend instances.
JWT_SECRET=<required — openssl rand -base64 32>

# ── Claude API ───────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
# Leave blank to run without AI (review submission will return an error).
CLAUDE_API_KEY=

# ── GitHub API token (optional) ──────────────────────────────────────────────
# Personal access token for fetching PR diffs from private repos or avoiding
# GitHub's unauthenticated rate limit (60 req/hr → 5000 req/hr).
# Scopes needed: repo (private) or public_repo (public only).
GITHUB_API_TOKEN=
