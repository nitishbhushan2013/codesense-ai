# CodeSense backend — environment variables
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must NEVER be committed. None of the values below are real secrets.
#
# Spring resolves these via ${VAR} / ${VAR:default} placeholders in
# src/main/resources/application.yml. Vars without a default in application.yml
# are REQUIRED — the app fails to start if they are unset.

# --- Database (PostgreSQL) ---------------------------------------------------
# DB_URL and DB_USERNAME have safe local defaults in application.yml; override
# them only for non-local databases.
DB_URL=jdbc:postgresql://localhost:5432/codesense_db
DB_USERNAME=postgres
# REQUIRED — password for the PostgreSQL user above.
DB_PASSWORD=your-local-postgres-password

# --- JWT (auth token signing) ------------------------------------------------
# REQUIRED — HMAC signing key for JWTs. Use a random string of at least 32 chars.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-min-32-chars

# --- GitHub OAuth (login) ----------------------------------------------------
# REQUIRED — from GitHub Developer Settings > OAuth Apps.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- GitHub API (PR diff fetching) -------------------------------------------
# Optional — personal access token used to fetch PR diffs. Empty default in
# application.yml; set it to raise rate limits / access private repos.
GITHUB_API_TOKEN=

# --- Claude API (AI code review) ---------------------------------------------
# Optional at boot (empty default in application.yml), but required for reviews
# to produce real results. From the Anthropic Console.
CLAUDE_API_KEY=
