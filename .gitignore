# Per-story personal design notes (kept locally, not shared)
docs/STORY-[0-9]*.md
# ...but story briefs are shared (committed at story start)
!docs/STORY-[0-9]*-brief.md

# Architecture decision records (kept locally, not shared)
docs/*Decision.md

# Local secrets — NEVER commit these
.env
.env.local
.env.*.local
backend/codesense-backend/application-local.yml

# E2E gate hook server logs
.e2e-gate/

# Dev server logs written by background processes
backend/codesense-backend/backend.log
frontend/codesense-frontend/frontend.log

# Windows crash dumps from Git-bundled bash (bash.exe.stackdump)
*.stackdump

# Claude Code local session settings (permissions are machine-specific)
.claude/settings.json
.claude/settings.local.json
